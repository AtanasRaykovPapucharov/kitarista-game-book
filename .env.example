# Copy to .env and fill in. Only variables prefixed with QCLI_ reach client code
# (read them as import.meta.env.QCLI_*). On Vercel, set them under
# Project Settings → Environment Variables.
#
# In development (quasar dev), while there is no .env file, the values below
# are used as placeholders. Production builds never read this file.
QCLI_API_URL=https://api.example.com

# ---------- Access code ("coming soon" gate) ----------
# Visitors must enter this code before they can see the app.
# Leave it empty to open the app to everyone.
# NO QCLI_ prefix on purpose: only a hash of it is built into the app.
# On Vercel, add ACCESS_CODE under Project Settings → Environment Variables.
# The value here is only a development placeholder.
ACCESS_CODE=test

# ---------- About the creators (page /creators) ----------
QCLI_CREATOR_NAME=Атанас Папучаров
QCLI_CREATOR_GITHUB=https://github.com/AtanasRaykovPapucharov
QCLI_CREATOR_WEBSITE=
QCLI_CREATOR_EMAIL=

# ---------- Support (page /support) ----------
# Leave a value empty to hide that method.
QCLI_SUPPORT_BUYMEACOFFEE=https://buymeacoffee.com/your-name
QCLI_SUPPORT_REVOLUT=https://revolut.me/your-name
QCLI_SUPPORT_PAYPAL=https://paypal.me/your-name
QCLI_SUPPORT_BTC=bc1q-your-bitcoin-address
QCLI_SUPPORT_LIGHTNING=your-name@your-lightning-wallet.com
QCLI_SUPPORT_ETH=0xYourEthereumAddress
QCLI_SUPPORT_USDT_TRC20=
